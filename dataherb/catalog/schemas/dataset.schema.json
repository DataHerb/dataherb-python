{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataherb.github.io/specs/dataset/v2.json",
  "title": "DataHerb dataset metadata (v2)",
  "description": "The dataherb.json / dataherb.yml file that lives next to the data (git repo root or S3 prefix). A superset of the v1 format written by dataherb-python; v1 files are valid. `datapackage` follows Frictionless Data Package.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "spec": { "enum": ["dataherb/v1", "dataherb/v2"] },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "documentation": { "type": "string", "description": "Longer Markdown documentation, or a URL to it." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "domain": { "type": "string", "description": "Business domain, e.g. finance, logistics." },
    "owner": {
      "description": "Who to ask about this dataset.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "team": { "type": "string" },
            "email": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      ]
    },
    "license": { "type": "string" },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "update_frequency": { "type": "string", "description": "e.g. hourly, daily, weekly, monthly, static, or an ISO 8601 duration." },
    "status_job": {
      "description": "Job id(s) whose status files describe this dataset's freshness.",
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "source": { "enum": ["git", "s3", "http", "local"] },
    "uri": { "type": "string", "description": "Base location of the dataset (repo URL, s3://bucket/prefix, https URL)." },
    "metadata_uri": { "type": "string" },
    "temporal_coverage": {
      "type": "object",
      "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
    },
    "related": {
      "type": "array",
      "description": "Other dataset ids this one is commonly joined with.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "on": { "type": "string", "description": "Join hint, e.g. \"orders.region_code = regions.code\"." }
        }
      }
    },
    "datapackage": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string", "description": "Relative to the dataset base, or an absolute https:// or s3:// URL." },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "format": { "type": "string", "examples": ["csv", "parquet", "json", "ndjson", "tsv"] },
        "mediatype": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "schema": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "description": { "type": "string" },
                  "unit": { "type": "string" },
                  "example": {}
                }
              }
            },
            "primaryKey": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
          }
        }
      }
    }
  }
}
